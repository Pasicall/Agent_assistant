# 复制为 .env.docker，填写强随机密码和模型配置：docker compose --env-file .env.docker up --build -d
POSTGRES_PASSWORD=replace-with-a-unique-database-password
REDIS_PASSWORD=replace-with-a-unique-redis-password
RAG_SECRET_KEY=replace-with-at-least-32-random-characters
RAG_QDRANT_API_KEY=replace-with-a-unique-qdrant-api-key
RAG_EMBEDDING_PROVIDER=sentence-transformers
RAG_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RAG_EMBEDDING_DIMENSION=512
RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RAG_LLM_BASE_URL=https://api.openai.com/v1
RAG_LLM_API_KEY=
RAG_LLM_MODEL=
RAG_VISION_MODEL=
RAG_OCR_ENABLED=true

# 浏览器入口；正式 HTTPS 入口将此项改为实际域名，并启用 secure cookie。
RAG_PUBLIC_BASE_URL=http://localhost:8080
# 创建所需普通账号后，可关闭公开注册；已有账号继续使用邮箱密码登录。
RAG_ALLOW_REGISTRATION=true
RAG_COOKIE_SECURE=false
RAG_CORS_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080"]
RAG_AUTH_RATE_PER_MINUTE=20
RAG_CHAT_RATE_PER_MINUTE=30
RAG_USER_STORAGE_MB=1024
RAG_MAX_PENDING_JOBS=20
RAG_MAX_ACTIVE_CHATS=2
RAG_GLOBAL_ACTIVE_CHATS=4
RAG_SERVICE_MEMORY=4g
RAG_SERVICE_CPUS=2.0
# 请求预算单位：普通问答1，Ragas案例6；不是精确token或费用账单。
RAG_USER_DAILY_MODEL_REQUESTS=500
# PDF 优先读取文字层；仅需要逐页视觉理解时开启。
RAG_PDF_VISION_ALL_PAGES=false
RAG_OCR_TIMEOUT=60
RAG_CITATION_VERIFIER=llm
RAG_VERIFIER_MODEL=
# 词项覆盖启发式阈值，需按业务题集校准，设0可禁用。
RAG_EVIDENCE_MIN_COVERAGE=0.25
RAG_METRICS_TOKEN=

# Goal-driven learning: fixed database transaction topic in v1
RAG_LEARNING_ENABLED=true
RAG_LEARNING_GENERAL_ENABLED=false
RAG_LEARNING_MODEL_REPAIRS=1
RAG_LEARNING_REMOTE_INPUT_BYTES=65536

# Optional developer tools and operator diagnostics
RAG_EVALUATION_ENABLED=false
RAG_BROWSER_SOURCE_SYNC_ENABLED=false
RAG_SOURCE_SYNC_ROOT=
RAG_DIAGNOSTICS_TOKEN=
